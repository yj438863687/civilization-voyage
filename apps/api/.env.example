# Local single-user only. Bind loopback; do not expose to a network.
VOYAGE_DB=voyage.sqlite3
# Optional explicit OpenAI chat-completions compatible endpoint. No auto discovery.
# VOYAGE_MODEL_URL=https://your-provider.example/v1/chat/completions
# VOYAGE_MODEL_NAME=your-model
# VOYAGE_MODEL_KEY=provided-by-you
# Optional multiple explicitly configured models (replaces the single-model settings):
# VOYAGE_MODELS=[{"id":"mate-a","url":"https://your-provider.example/v1/chat/completions","model":"your-model","key_env":"VOYAGE_SECRET_A"}]
# VOYAGE_SECRET_A=provided-by-you
# Environment files are NOT loaded automatically. Export only these explicit variables.
