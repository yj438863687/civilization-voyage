            "type": "string",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "confirmation": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed"
            ],
            "title": "Confirmation",
            "default": "pending"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "role"
        ],
        "title": "Crew"
      },
      "Event": {
        "properties": {
          "seq": {
            "type": "integer",
            "title": "Seq"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "seq",
          "task_id",
          "kind",
          "data"
        ],
        "title": "Event"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Capabilities"
          },
          "credential_source": {
            "type": "string",
            "const": "server_environment",
            "title": "Credential Source",
            "default": "server_environment"
          }
        },
        "type": "object",
        "required": [
          "id",
          "model",
          "capabilities"
        ],
        "title": "ModelInfo"
      },
      "Port": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "goods": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            "type": "object",
            "title": "Goods"
          },
          "resource_kind": {
            "type": "string",
            "const": "fictional_test_resource",
            "title": "Resource Kind",
            "default": "fictional_test_resource"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "goods"
        ],
        "title": "Port"
      },
      "Record": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "material",
              "fragment",
              "choice",
              "artifact",
              "log",
              "reflection"
            ],
            "title": "Kind"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "classification": {
            "type": "string",
            "enum": [
              "historical_claim",
              "counterfactual",
              "creative",
              "test"
            ],
            "title": "Classification"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "material_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Material Ids"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version",
            "default": 1
          },
          "access": {
            "type": "string",
            "const": "private",
            "title": "Access",
            "default": "private"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "voyage_id": {
            "type": "string",
            "title": "Voyage Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "text",
          "classification",
          "id",
          "voyage_id"
        ],
        "title": "Record"
      },
      "RecordCreate": {
        "properties": {
          "kind": {
            "type": "string",
